# --- Secrets: never commit these ------------------------------------------
ansible/inventories/*/group_vars/**/vault.yml
ansible/inventories/*/group_vars/**/vault.yml.unencrypted
.vault-pass
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
id_ed25519*
id_rsa*

# --- Terraform runtime state ----------------------------------------------
**/.terraform/
**/terraform.tfstate*
**/errored.tfstate*
**/*.tfplan
**/tfplan*
terraform/plan.txt
terraform/backend_override.tf
terraform/backend.hcl
terraform/terraform.tfvars

# --- Generated by Terraform (re-created by `make inventory`) --------------
ansible/inventories/*/hosts.yml
ansible/inventories/*/group_vars/**/terraform.yml

# --- Ansible runtime ------------------------------------------------------
ansible/collections/
ansible/.ansible-facts/
**/*.retry

# --- Python / tooling -----------------------------------------------------
**/__pycache__/
**/*.py[cod]
.venv/
.pytest_cache/

# --- Editor / OS ----------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
