---
# Copy to vault.yml and encrypt before local production use:
#   ansible-vault encrypt inventories/qdrant-production/group_vars/all/vault.yml

vault_qdrant_backup_aws_access_key_id: "REPLACE-ME"
vault_qdrant_backup_aws_secret_access_key: "REPLACE-ME"
vault_qdrant_backup_slack_webhook_url: "REPLACE-ME"
vault_qdrant_backup_ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  REPLACE-ME
  -----END OPENSSH PRIVATE KEY-----
