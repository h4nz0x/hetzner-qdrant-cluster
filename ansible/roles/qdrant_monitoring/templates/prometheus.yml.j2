# Managed by Ansible.
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

rule_files:
  - /etc/prometheus/qdrant-alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: qdrant
    metrics_path: /metrics
    static_configs:
      - targets:
{% for host in groups['qdrant'] %}
          - "{{ hostvars[host].qdrant_private_ip }}:{{ qdrant_metrics_port }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance
        replacement: "$1"

  - job_name: node
    static_configs:
      - targets:
{% for host in groups['qdrant'] %}
          - "{{ hostvars[host].qdrant_private_ip }}:9100"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance
        replacement: "$1"
