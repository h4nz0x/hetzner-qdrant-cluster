# Managed by Ansible.
global:
  resolve_timeout: 5m

route:
  receiver: {{ 'slack' if (vault_alertmanager_slack_webhook_url | default('')) else 'blackhole' }}
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: blackhole
{% if vault_alertmanager_slack_webhook_url | default('') %}
  - name: slack
    slack_configs:
      - api_url: "{{ vault_alertmanager_slack_webhook_url }}"
        channel: "{{ alertmanager_slack_channel }}"
        username: qdrant-alerts
        icon_emoji: ":rotating_light:"
        send_resolved: true
        title: "{{ '{{ .Status | toUpper }}' }}: {{ '{{ .CommonLabels.alertname }}' }}"
        text: |-
          *Summary:* {{ '{{ .CommonAnnotations.summary }}' }}
          *Description:* {{ '{{ .CommonAnnotations.description }}' }}
          *Instance:* {{ '{{ .CommonLabels.instance }}' }}
{% endif %}
